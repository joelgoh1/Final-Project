# Copy to .env - the app reads it on startup and never overrides a real env var.
# Only credentials belong here; card rules and fixtures live in data/.

# --- AI strategist (OpenCode) -----------------------------------------------------
# Leave OPENCODE_API_KEY blank to run fully local: the dashboard works without it,
# the strategist card simply reports itself unavailable.
OPENCODE_API_KEY=
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4.1-flash

# --- Google (not used by v1) ---------------------------------------------------
# A v2 idea: resolve unmapped merchants with Places Text Search to shrink the
# General Spend bucket. Out of scope for v1, so these are placeholders only.
# GOOGLE_PLACES_API_KEY=
# GOOGLE_MAPS_API_KEY=
